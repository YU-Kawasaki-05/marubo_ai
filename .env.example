# ============================================================
# Marubo AI — 環境変数テンプレート
# コピーして .env.local を作成: cp .env.example .env.local
# ============================================================

# ── Supabase（必須） ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=               # サーバーAPIのみ利用（Edge不可）

# ── Supabase（公開設定・任意） ──
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SUPPORT_FORM_URL=https://example.com/contact

# ── LLM: チャット用（必須） ──
OPENAI_API_KEY=                          # @ai-sdk/openai が自動読み込み
CHAT_LLM_MODEL=                         # チャット応答 + タイトル生成（未設定時: gpt-4o-mini）

# ── LLM: 月次レポート生成用（任意） ──
REPORT_LLM_MODEL=                        # 例: gpt-4o, claude-sonnet-4-20250514（未設定時: gpt-4o-mini）
REPORT_LLM_API_KEY=                      # 未設定時は OPENAI_API_KEY を使用
REPORT_MAX_TOKENS_OUT=2000
REPORT_CHUNK_SIZE=                       # 1回あたりの処理人数（未設定時: 3）
REPORT_DELAY_MS=                         # 生徒間ディレイ ms（未設定時: 5000）

# ── メール通知: Resend（本番必須） ──
RESEND_API_KEY=                          # Resend ダッシュボードで取得（セットアップ手順は docs/deployment.md 参照）
ADMIN_EMAILS=                            # S1 障害通知先（セミコロン区切り）例: staff1@example.com;staff2@example.com
MAIL_FROM="noreply@your-domain.example"  # Resend で検証済みのドメインを使用

# ── アプリ設定 ──
MONTHLY_QUOTA=100                        # 月間質問クォータ（生徒1人あたり）
GRANT_ALLOWED_EMAILS=                    # スタッフ権限付与を許可するメールアドレス（セミコロン区切り）

# ── テスト/開発用（本番では設定不要） ──
MOCK_SUPABASE=                           # 'true' でインメモリ DB モック有効化（CI/招待待ち時に使用）

# ── Vercel 自動設定（手動設定不要） ──
# CRON_SECRET=                           # Vercel が自動生成・自動設定。ローカルではコメントアウトのまま
